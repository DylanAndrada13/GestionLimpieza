# Copiar este valor a Vercel > Project > Settings > Environment Variables.
# No usar un valor real en el repositorio.
EZ_CATALOG_API_KEY=

# Backend-only credentials. Prefer the current Supabase Secret key (sb_secret_...).
# Never put either key in VITE_* variables.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback, only needed if the project still uses the old JWT key:
SUPABASE_SERVICE_ROLE_KEY=
