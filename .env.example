# Copiar este valor a Vercel > Project > Settings > Environment Variables.
# No usar un valor real en el repositorio.
EZ_CATALOG_API_KEY=

# Backend-only credentials. Prefer the current Supabase Secret key (sb_secret_...).
# Never put either key in VITE_* variables.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback, only needed if the project still uses the old JWT key:
SUPABASE_SERVICE_ROLE_KEY=
# Required private access password for this shop's inventory APIs. Use a long,
# unique value and set the same secret in local development and Vercel.
SHOP_ACCESS_PASSWORD=

# Shop server used to read the latest Mercado Pago collections (default https://perfumeria-cr.vercel.app).
SHOP_API_URL=
# Same value as STAFF_API_KEY in the shop.
SHOP_STAFF_API_KEY=
